# Copie para .env.local e ajuste conforme o ambiente.
# `docker-compose.yml` lê este arquivo via `env_file` no serviço `api`.

APP_ENV=development

# ── Portas (bloco reservado 45000-45699) ─────────────────────────────────────
API_PORT=45101
FRONTEND_PORT=45001
POSTGRES_HOST_PORT=45501

# ── Banco ─────────────────────────────────────────────────────────────────────
POSTGRES_DB=govcompras
POSTGRES_USER=govcompras_user
POSTGRES_PASSWORD=govcompras_password

# ── Segurança ─────────────────────────────────────────────────────────────────
# Gerado automaticamente em desenvolvimento se deixado em branco (nunca em
# produção — a aplicação recusa subir sem SECRET_KEY quando APP_ENV=production).
SECRET_KEY=

# Segredo compartilhado com a plataforma GovSistem para validar o login único
# (token `module_access`). Só é exigido quando o módulo estiver de fato
# integrado ao shell central — pode ficar vazio na POC standalone.
SAAS_JWT_SECRET=
SAAS_API_URL=

# Ponte de login de demonstração (seção 128 da especificação) — permite entrar
# com as 7 personas fictícias sem depender da plataforma central. NUNCA deixar
# como "true" em produção.
ENABLE_DEV_LOGIN=true

# URL pública do módulo quando publicado atrás do nginx de borda
# (ex.: https://govcompras.govsistem.com.br). Em desenvolvimento local, deixe
# como está.
GOVCOMPRAS_PUBLIC_URL=http://127.0.0.1:45001
