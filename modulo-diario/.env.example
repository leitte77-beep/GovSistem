# ===========================================
# Módulo Diário — Environment Configuration
# ===========================================
# Copy this file to .env and fill in values.
# Never commit .env to version control.

# --- App ---
APP_NAME="Modulo Diario API"
DEBUG=false
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS='["http://localhost:9202","http://localhost:9200"]'
PUBLIC_URL=http://localhost:9200

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=modulo_diario
POSTGRES_USER=diario_user
POSTGRES_PASSWORD=change-me-in-dev

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- MinIO / Object Storage ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me-in-dev
MINIO_SECRET_KEY=change-me-in-dev
MINIO_BUCKET=doe-publicacoes
MINIO_SECURE=false
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change-me-in-dev

# --- Security ---
SECRET_KEY=change-me-in-dev
INTERNAL_API_KEY=change-me-in-dev
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Signer ---
SIGNER_URL=http://signer:8100
SIGNER_PROVIDER=a1
SIGNER_A1_PFX_PATH=/certs/cert.pfx
SIGNER_A1_PASSWORD=
VERIFICATION_BASE_URL=https://farol.govsistem.com.br/verificar

# --- API / Worker ---
API_URL=http://api:8000
WORKER_CONCURRENCY=4

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=uploads
STORAGE_TENANT_ISOLATION=true

# --- Frontend URLs ---
NEXT_PUBLIC_API_URL=http://localhost:9201/api/v1
NEXT_PUBLIC_ADMIN_URL=http://localhost:9202

# --- Observability (optional) ---
SENTRY_DSN=

# --- Antivirus (optional) ---
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Centralized DeepSeek AI (optional; server-safe defaults) ---
# The per-organization API key is NOT stored here. It is registered encrypted
# at runtime via Configurações → Inteligência artificial (PUT /api/v1/ai/config)
# or POST /api/v1/ai/config/key. These vars only set server-side defaults/limits.
# DEEPSEEK_API_BASE=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# AI_DEFAULT_TIMEOUT_SECONDS=60
# AI_MAX_TOKENS=4096
# AI_MAX_CONCURRENCY=4
# AI_MAX_RETRIES=3
