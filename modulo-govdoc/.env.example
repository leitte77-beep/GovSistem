# ─────────────────────────────────────────────────────────────────────────────
# GovDoc — Gestão de Documentos
#
# Copie para .env.local (o setup faz isso automaticamente e gera os segredos).
# NUNCA versione .env.local nem coloque segredos reais neste arquivo.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=development
APP_HOST=127.0.0.1
DEBUG=true
LOG_LEVEL=INFO

# ── Portas ───────────────────────────────────────────────────────────────────
# auto  = procura automaticamente uma porta livre na faixa do serviço
# fixed = usa exatamente as portas abaixo e falha (com mensagem clara) se ocupadas
PORT_MODE=auto
FRONTEND_PORT=43001
API_PORT=43101
STORAGE_API_PORT=43301
STORAGE_CONSOLE_PORT=43201
MAIL_PORT=43401
POSTGRES_HOST_PORT=43501
REDIS_HOST_PORT=43601

# ── Banco de dados ───────────────────────────────────────────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=43501
POSTGRES_DB=govdoc
POSTGRES_USER=govdoc_user
POSTGRES_PASSWORD=
# Alternativa: informe a URL completa (tem prioridade sobre os campos acima)
DATABASE_URL_OVERRIDE=

# ── Redis (opcional) ─────────────────────────────────────────────────────────
REDIS_URL=

# ── Armazenamento de arquivos ────────────────────────────────────────────────
# local = diretório privado do servidor | s3 = MinIO, AWS S3, R2, B2, Wasabi...
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=storage
S3_ENDPOINT=http://127.0.0.1:43301
S3_REGION=us-east-1
S3_BUCKET=govdoc-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=300

# ── Upload ───────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=500
MAX_UPLOAD_BATCH_MB=2000
MAX_CONCURRENT_UPLOADS=5
ANTIVIRUS_ENABLED=true
# Deixe vazio para usar a verificação heurística local; preencha para usar ClamAV
CLAMAV_HOST=
CLAMAV_PORT=3310

# ── Segurança ────────────────────────────────────────────────────────────────
SECRET_KEY=
# Login único: segredo usado pela plataforma GovSistem para assinar os tokens
# module_access. Sem ele, tokens do SaaS são rejeitados.
SAAS_JWT_SECRET=
INTERNAL_API_KEY=
# API da plataforma GovSistem (somente ponte dev): http://host.docker.internal:9009/api/v1
SAAS_API_URL=
# Habilita a ponte de sessão de desenvolvimento (/auth/dev/session) e a sessão
# técnica dos testes (/auth/dev/e2e-session). NUNCA ativar em produção.
ENABLE_DEV_SAAS_AUTH=false
ENABLE_DEV_E2E_AUTH=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
EXTERNAL_RATE_LIMIT_REQUESTS=30
CORS_ORIGINS=http://127.0.0.1:43001,http://localhost:43001,http://127.0.0.1:43000,http://localhost:5173
PUBLIC_URL=http://127.0.0.1:43001

# ── Lixeira e retenção ───────────────────────────────────────────────────────
TRASH_RETENTION_DAYS=30
EXPIRY_ALERT_DAYS=180,90,60,30,15,7,1
DOCUMENT_LOCK_MINUTES=30

# ── Backup ───────────────────────────────────────────────────────────────────
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
# Aponte para fora da aplicação: disco secundário, NAS ou s3://bucket/prefixo
BACKUP_DESTINATION=
BACKUP_ENCRYPTION_PASSWORD=
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
BACKUP_VERIFY_AFTER_RUN=true

# ── Tarefas automáticas ──────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300

# ── Extração de texto e OCR ──────────────────────────────────────────────────
TEXT_EXTRACTION_ENABLED=true
OCR_ENABLED=false
TESSERACT_PATH=tesseract
TESSERACT_LANG=por
