# ─────────────────────────────────────────────────────────────────────────────
# GovInfra — configuração local
#
# Copie para `.env.local` (o `npm run setup` faz isso e já gera os segredos).
# Nenhum segredo real deve ser versionado neste arquivo.
#
# As PORTAS abaixo são apenas a PREFERÊNCIA. O `scripts/resolve-ports.mjs`
# confere se estão livres e, no modo automático, escolhe a próxima porta livre
# dentro da faixa reservada do módulo. Nenhum processo de terceiros é encerrado
# e nenhuma porta de outro módulo é alterada.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# auto  = procura porta livre na faixa do módulo quando a preferida está ocupada
# fixed = exige exatamente a porta configurada e falha com mensagem clara
PORT_MODE=auto

# ── Portas (faixa reservada do GovInfra: 44000-44699) ────────────────────────
GOVINFRA_FRONTEND_PORT=44001
GOVINFRA_API_PORT=44101
GOVINFRA_STORAGE_CONSOLE_PORT=44201
GOVINFRA_STORAGE_PORT=44301
GOVINFRA_TILES_PORT=44401
GOVINFRA_DATABASE_PORT=44501
GOVINFRA_REDIS_PORT=44601

# ── Banco de dados ───────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=44501
POSTGRES_DB=govinfra
POSTGRES_USER=govinfra_user
POSTGRES_PASSWORD=
# Preenchido pelo resolvedor de portas; sobrepõe o host/porta acima quando definido.
DATABASE_URL_OVERRIDE=

# ── Redis (opcional — há fallback em memória) ────────────────────────────────
REDIS_URL=

# ── Armazenamento de arquivos ────────────────────────────────────────────────
# local = disco (desenvolvimento) | s3 = MinIO/S3 (produção)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=govinfra-arquivos
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

MAX_FILE_SIZE_MB=50
MAX_VIDEO_SIZE_MB=200

# ── Segurança ────────────────────────────────────────────────────────────────
SECRET_KEY=
# Segredo compartilhado com a plataforma GovSistem (valida o token module_access).
SAAS_JWT_SECRET=
SAAS_API_URL=http://127.0.0.1:9009/api/v1
INTERNAL_API_KEY=
# Ponte de login usada apenas em desenvolvimento. Em produção deve ficar false.
ENABLE_DEV_SAAS_AUTH=false
ENABLE_DEV_E2E_AUTH=false

RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60

# ── Georreferenciamento ──────────────────────────────────────────────────────
# Provedor de geocodificação: nominatim | none.
# A indisponibilidade do provedor NUNCA impede o cadastro: a marcação manual do
# ponto no mapa é sempre aceita.
GEOCODE_PROVIDER=nominatim
GEOCODE_BASE_URL=https://nominatim.openstreetmap.org
GEOCODE_USER_AGENT=GovInfra/1.0 (prefeitura)
GEOCODE_TIMEOUT_SECONDS=6
# Camada base do mapa (trocável — o front lê estas variáveis, nada é fixado no código).
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap
MAP_DEFAULT_LAT=-27.2100
MAP_DEFAULT_LON=-52.0270
MAP_DEFAULT_ZOOM=12

# ── Município atendido (usado nos padrões de cadastro e relatórios) ──────────
MUNICIPIO_NOME=Município
MUNICIPIO_UF=SC

# ── Tarefas automáticas (alertas de vencimento, atrasos, manutenção) ─────────
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=600
