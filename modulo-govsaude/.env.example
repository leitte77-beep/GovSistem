# GovSaúde — copie para .env e ajuste. Nunca comite segredos reais.
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_PORT=8210

POSTGRES_HOST=localhost
POSTGRES_PORT=5440
POSTGRES_DB=govsaude
POSTGRES_USER=govsaude_user
POSTGRES_PASSWORD=change-me
# DATABASE_URL_OVERRIDE=postgresql+asyncpg://govsaude_user:change-me@localhost:5440/govsaude

REDIS_URL=redis://localhost:6381/0

STORAGE_BACKEND=s3
S3_ENDPOINT=localhost:9102
S3_BUCKET=govsaude-files
S3_ACCESS_KEY=minio_access
S3_SECRET_KEY=minio_secret
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=300

SECRET_KEY=change-me-32-bytes
SAAS_JWT_SECRET=change-me-mesmo-segredo-do-saas
INTERNAL_API_KEY=change-me-internal-key
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_OLD=
CPF_HMAC_KEY=

CORS_ORIGINS=["http://localhost:7601","https://saude.govsistem.com.br"]
PUBLIC_URL=http://localhost:7601
API_PUBLIC_URL=http://localhost:8210

CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

RNDS_ENV=HOMOLOGACAO
RNDS_BASE_URL_HOMOLOGACAO=
RNDS_BASE_URL_PRODUCAO=
RNDS_CERT_PATH=
RNDS_CERT_PASSWORD=

INTEGRACOES_AUTOMATICAS=false
SCHEDULER_ENABLED=true
