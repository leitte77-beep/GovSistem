# Copie para modulo-govpro/web/.env.local (gitignored).

# URL do SaaS (para onde o usuário é redirecionado ao deslogar/expirar token)
NEXT_PUBLIC_SAAS_URL=https://admin.govsistem.com.br

# URL da API GovPro (o proxy /api/govpro/[...path] encaminha para cá).
# Em produção a borda nginx encaminha /api/govpro/ direto para a API; este
# valor é fallback para dev/local.
# Docker: http://govpro-api:8000/api/govpro/v1
# Local:  http://localhost:8203/api/govpro/v1
GOVPRO_API_URL=http://localhost:8203/api/govpro/v1

# Produção:
#   Área interna  -> https://govpro.govsistem.com.br  (este app)
#   Portal externo-> https://proc.govsistem.com.br     (portal do cidadão)
