# GovPro — Processo Administrativo Eletrônico
# Copie para modulo-govpro/.env e preencha (o .env é gitignored).

# PostgreSQL (usa o postgres do stack infra, banco próprio `govpro`)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=govpro
POSTGRES_USER=govpro_user
POSTGRES_PASSWORD=CHANGE_ME

# JWT / SSO (igual ChatGov: o login vem do SaaS)
# JWT_SECRET é a chave local; JWT_SECRETS lista as chaves de assinatura do SaaS (vírgulas).
JWT_SECRET=govpro-dev-secret-change-in-production
JWT_SECRETS=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Chave interna para o SaaS chamar /internal/sync-* (tem que bater com INTERNAL_API_KEY do SaaS)
INTERNAL_API_KEY=CHANGE_ME

# Chave para assinar tokens locais (dev/e2e) — distinta da chave do SaaS
SECRET_KEY=CHANGE_ME

# MinIO (bucket do módulo, prefixado por tenant)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=govpro-files
MINIO_SECURE=false

# Origens permitidas (CORS). Em produção: os dois domínios do módulo.
# ATENÇÃO: pydantic-settings v2 exige JSON para List[str].
CORS_ORIGINS=["https://govpro.govsistem.com.br","https://proc.govsistem.com.br"]
# URL pública do portal externo (usada em links/recibos).
PUBLIC_URL=https://proc.govsistem.com.br

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# Celery / Redis (jobs de manutenção: desclassificação de sigilo + reativação)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ICP-Brasil — assinatura qualificada (PAdES/CAdES + carimbo de tempo RFC 3161).
# Sem ICP_TSA_URL o carimbo fica desativado (assina CAdES-BES, sem T).
ICP_TSA_URL=
ICP_TSA_TIMEOUT_S=10
ICP_TSA_RETRIES=2

DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=development
