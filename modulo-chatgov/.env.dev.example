# Copie para .env.dev. Nunca use segredos nem dados de producao aqui.
POSTGRES_DB=chatgov_dev
POSTGRES_USER=chatgov_dev
POSTGRES_PASSWORD=troque-esta-senha-dev
JWT_SECRET=troque-este-jwt-dev
CREDS_ENCRYPTION_KEY=troque-esta-chave-dev-com-32-caracteres
INTERNAL_API_KEY=troque-esta-chave-interna-dev

# Portas publicadas apenas em 127.0.0.1 (acesso por SSH tunnel).
CHATGOV_DEV_BACKEND_PORT=13050
CHATGOV_DEV_FRONTEND_PORT=13051
ENABLE_DEV_E2E_AUTH=true
